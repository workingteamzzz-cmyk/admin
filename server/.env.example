# Copy to .env and fill in. Never commit .env.

# Anthropic API key from https://console.anthropic.com (Settings → API keys). Required.
ANTHROPIC_API_KEY=

# The address people open in their browser (used for invitation links and request checks).
PUBLIC_URL=https://canopus.kantor.go.id

# Email of the first administrator. On first start the server prints a one-time link to set the password.
CANOPUS_ADMIN_EMAIL=

# Where the database, uploaded files and knowledge documents are stored.
DATA_DIR=./data

PORT=8080
HOST=0.0.0.0

# Set to true when running behind a reverse proxy (Caddy, Nginx, load balancer) so client IPs are logged correctly.
TRUST_PROXY=true

# Hours a sign-in stays valid without activity.
SESSION_HOURS=12

# Maximum upload size per file, in MB.
MAX_UPLOAD_MB=25

# If the server can only reach the internet through a corporate proxy:
# CANOPUS_OUTBOUND_PROXY=http://proxy.kantor.go.id:8080
